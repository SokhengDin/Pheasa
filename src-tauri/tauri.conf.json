{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phasa",
  "version": "0.1.0",
  "identifier": "dev.sokheng.livetranslator",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Phasa",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 560,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 22 }
      },
      {
        "label": "overlay",
        "title": "Subtitles",
        "url": "index.html#overlay",
        "width": 920,
        "height": 190,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
